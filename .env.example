# Copy this file to .env only for local process environment management.
# Do not commit .env or replace these placeholders with real credentials here.
DB_URL=jdbc:mysql://localhost:3306/bitecart?useSSL=true&serverTimezone=UTC
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_database_password

# Optional production tuning values.
SERVER_PORT=8080
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
JPA_DDL_AUTO=validate
